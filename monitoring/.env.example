# Monitoring stack secrets. Copy to .env on the VPS (root/deploy-only, never committed).
#   cp .env.example .env  &&  edit
# Grafana admin login (the public dashboards are anonymous read-only; this is the
# password-gated admin account).
GRAFANA_ADMIN_PASSWORD=change-me
# Reuse the existing Supabase Postgres password (same value as the stack's
# POSTGRES_PASSWORD in /opt/chtivo/.env) so postgres-exporter can connect to `db`.
POSTGRES_PASSWORD=change-me
