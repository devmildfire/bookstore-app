# ───────────────────────────────────────────────────────────────────────────
# Production env for /opt/chtivo on the VPS. Copy to `.env`, fill in real values,
# chmod 600. NEVER commit the real .env. (This .example carries no secrets.)
#
# Generate fresh secrets for PRODUCTION — do NOT reuse the local-dev Supabase
# demo keys (they are publicly known; reusing them = full DB compromise):
#
#   POSTGRES_PASSWORD   openssl rand -hex 24
#   JWT_SECRET          openssl rand -hex 32      # >= 32 chars
#   SECRET_KEY_BASE     openssl rand -hex 32
#   PG_META_CRYPTO_KEY  openssl rand -hex 32
#   ANON_KEY / SERVICE_ROLE_KEY  → JWTs signed with JWT_SECRET (see README;
#                                  generate with the Supabase key tool / jwt.io,
#                                  role=anon and role=service_role, same secret)
# ───────────────────────────────────────────────────────────────────────────

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_PASSWORD=__CHANGE_ME__

# ── JWT / API keys (must all be derived from the SAME JWT_SECRET) ─────────────
JWT_SECRET=__CHANGE_ME__
JWT_EXPIRY=3600
ANON_KEY=__CHANGE_ME__
SERVICE_ROLE_KEY=__CHANGE_ME__

# ── Public URLs (through Cloudflare) ──────────────────────────────────────────
SITE_URL=https://bookstore-app.mildfire.dev
API_EXTERNAL_URL=https://api.mildfire.dev
SUPABASE_PUBLIC_URL=https://api.mildfire.dev
ADDITIONAL_REDIRECT_URLS=https://bookstore-app.mildfire.dev/auth/confirm,https://bookstore-app.mildfire.dev/auth/callback

# ── Auth behaviour (mirrors local config.toml) ───────────────────────────────
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false   # double opt-in (confirmations on)
ENABLE_ANONYMOUS_USERS=true
# GoTrue requires SMTP_* vars to exist, but we send via the Resend Send-Email hook
# (below), so these are placeholders GoTrue never actually uses for delivery.
SMTP_ADMIN_EMAIL=admin@mildfire.dev
SMTP_HOST=localhost
SMTP_PORT=2500
SMTP_USER=noop
SMTP_PASS=noop
SMTP_SENDER_NAME=Chtivo
MAILER_URLPATHS_INVITE=/auth/confirm
MAILER_URLPATHS_CONFIRMATION=/auth/confirm
MAILER_URLPATHS_RECOVERY=/auth/confirm
MAILER_URLPATHS_EMAIL_CHANGE=/auth/confirm
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

# ── Send-Email hook (GoTrue → Next.js → Resend), internal docker URL ──────────
SEND_EMAIL_HOOK_SECRET=__CHANGE_ME__   # v1,whsec_<base64> (Standard-Webhooks)

# ── Realtime / meta ───────────────────────────────────────────────────────────
SECRET_KEY_BASE=__CHANGE_ME__
PG_META_CRYPTO_KEY=__CHANGE_ME__

# ── Storage (mirror local so the restored /mnt/stub/stub/... files resolve) ───
GLOBAL_S3_BUCKET=stub
STORAGE_S3_REGION=local
S3_PROTOCOL_ACCESS_KEY_ID=__CHANGE_ME__
S3_PROTOCOL_ACCESS_KEY_SECRET=__CHANGE_ME__

# ── Studio (private; reached via SSH tunnel only) ─────────────────────────────
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=__CHANGE_ME__
STUDIO_DEFAULT_ORGANIZATION=Chtivo
STUDIO_DEFAULT_PROJECT=chtivo

# ── Next.js app (image from GHCR) ─────────────────────────────────────────────
APP_IMAGE=ghcr.io/devmildfire/bookstore-app:production
# Canonical public identity (metadataBase / OG / sitemap), baked at build.
NEXT_PUBLIC_BASE_URL=https://bookstore-app.mildfire.dev
# Runtime origin for redirects + payment callbacks (getSiteOrigin reads it first).
APP_BASE_URL=https://bookstore-app.mildfire.dev
# The browser hits its own origin under /sb; the app proxies /sb/* to Supabase
# over the docker network (SUPABASE_INTERNAL_URL) and injects SUPABASE_ANON_KEY.
# No Supabase host/key is baked into the image — all runtime.
SUPABASE_INTERNAL_URL=http://kong:8000
SUPABASE_ANON_KEY=${ANON_KEY}
SUPABASE_SERVICE_ROLE_KEY=${SERVICE_ROLE_KEY}
# App email + integrations
RESEND_API_KEY=__CHANGE_ME__
RESEND_FROM_EMAIL=Chtivo <no-reply@mildfire.dev>
RESEND_AUDIENCE_ID=__CHANGE_ME__
ADMIN_NOTIFICATIONS_EMAIL=admin@mildfire.dev
# Payments (start in mock until Robokassa creds are live)
PAYMENT_PROVIDER=mock
# OAuth (Google). Set GOOGLE_ENABLED=true + the client creds. In Google Cloud
# Console, the OAuth client must authorize the redirect URI
# https://api.mildfire.dev/auth/v1/callback and the consent screen must list
# mildfire.dev as an authorized domain.
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# ── Cloudflare Tunnel ─────────────────────────────────────────────────────────
# Token from `cloudflared tunnel` (dashboard or CLI). Routes the proxied
# hostnames to the internal nginx. Keeps the origin off the public internet.
CLOUDFLARE_TUNNEL_TOKEN=__CHANGE_ME__
