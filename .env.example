# Supabase
# Local dev: http://localhost:54321
# Self-hosted on same VPS: https://api.yourdomain.com (public-facing URL behind reverse proxy)
# Supabase Cloud: https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (email delivery)
RESEND_API_KEY=

# YooKassa (test mode only)
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=

# Payments — Robokassa
# PAYMENT_PROVIDER=mock uses the built-in stand-in gateway (interactive fake
# payment page) that behaves exactly like Robokassa. Switch to "robokassa" and
# fill in the real credentials to go live — handlers/signatures are unchanged.
PAYMENT_PROVIDER=mock
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD_1=
ROBOKASSA_PASSWORD_2=
ROBOKASSA_IS_TEST=1
ROBOKASSA_HASH_ALGO=md5
# Shared secret for the recurring-charge cron route (x-cron-secret header)
PAYMENT_CRON_SECRET=

# App
NEXT_PUBLIC_BASE_URL=https://devmildfire.net
