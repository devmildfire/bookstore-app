{
  "name": "bookstore-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "//browserslist": "Modern targets (browsers from the last 4 years natively support ES2021+) so SWC stops shipping legacy transforms/polyfills (PSI 'legacy JavaScript'). ~95.6% global coverage incl. mobile — verified with `npx browserslist --coverage`. Pinned via caniuse-lite in the lockfile.",
  "browserslist": [
    "last 4 years",
    "not dead",
    "> 0.2%"
  ],
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src",
    "test:coverage": "vitest run src --coverage",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "stress": "node scripts/stress-test/stress-runner.mjs",
    "prepare": "husky"
  },
